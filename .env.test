# Loaded by core/config.py when ENV=test is exported (e.g. by tests/conftest.py).
# No database, no broker: the service reads its data release from data/.

# ── Core ──
ENV=test

# ── Data ──
# Empty: the repository's data/ (what the image ships).
DSO_DATA_DIR=
DSO_DATA_FIXTURE=false

# ── Observability ──
# Empty: tracing/metrics exporters are no-ops without endpoints.
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
