# Template for local development — copy to .env.local (ENV defaults to "local").
# The real settings contract lives in core/config.py.
#
# dso-lookup is INTERNAL (crm-backend is its only caller): no CORS, no gateway
# headers, no database. Never list it in ANNEX_CATALOG_* — crm-backend exits at
# boot on a name it does not know.

# ── Core ──
ENV=local

# ── Data ──
# The pinned belgian-dso-map release. Empty means the repository's data/, which
# only scripts/sync_data.py writes. A directory that fails the checks of
# api/dso/store.py fails the boot.
DSO_DATA_DIR=
# true ONLY to serve a fixture build that is not a draft; readiness then skips
# the national counts (565 communes). Refused in production.
DSO_DATA_FIXTURE=false

# ── Localization ──
DEFAULT_LOCALE=fr-BE

# ── Observability (optional in local) ──
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
