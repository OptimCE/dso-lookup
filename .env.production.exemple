# Template for .env.production — copy to .env.production and fill in real values.
# Pydantic will refuse to start the service if any required key below is missing.

# ── Core ──
ENV=production

# ── Data ──
# Leave empty: the image ships its data release in /app/data. A data bump is a
# new image (merge the "dso data X → Y" pull request; build.yml publishes it).
DSO_DATA_DIR=
# Never true in production (the settings validator refuses it).
DSO_DATA_FIXTURE=false

# ── Localization ──
DEFAULT_LOCALE=fr-BE

# ── Observability (required in production) ──
#
# Leaving them BLANK is inert rather than harmful: core/tracing.py returns
# early and logs a warning - but in production core/config.py refuses to boot
# without LOGGING_TOKEN, LOGGING_LOGS_URL and LOGGING_METRICS_URL.
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
